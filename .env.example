# =============================================================
# 振動監測平台 — 設定範本
#
# 使用方式：
#   1. 複製一份為 .env       cp .env.example .env
#   2. 依實際環境修改下方的值
#   3. .env 已列入 .gitignore，不會被提交
#
# 注意：系統環境變數優先於本檔。正式機若已由系統或容器注入環境變數，
#       本檔的同名設定不會生效（這是刻意的，避免忘了刪的開發用設定
#       讓服務安靜地連到錯的資料庫）。
# =============================================================


# ── 資料庫連線 ────────────────────────────────────────────────
# 建庫方式見 docs/USAGE.md §1.3

VIB_DB_HOST=localhost
VIB_DB_PORT=5432
VIB_DB_NAME=vibration
VIB_DB_USER=vibapp
VIB_DB_PASSWORD=


# ── Agent API 金鑰 ────────────────────────────────────────────
# 發給 Profet AI 平台呼叫本系統 API 時使用，對應請求標頭
# X-VIB-API-Key。未設定時 API 一律回 503（拒絕服務而非放行）。
#
# 產生一組隨機金鑰：
#   python -c "import secrets; print(secrets.token_urlsafe(32))"

VIB_AGENT_API_KEY=


# ── 選用設定 ──────────────────────────────────────────────────

# send_report 每日寄送次數上限，超過回 429（預設 3）
# VIB_REPORT_DAILY_LIMIT=3
